# MongoDB (required)
MONGODB_URI=
MONGODB_NAME=

# Agent Agar / AI Workspace
# Provider selection: ollama | openai | anthropic | google | groq
AI_PROVIDER=ollama
AI_MAX_STEPS=6

# Ollama (local, default provider)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI (only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (only needed if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google (only needed if AI_PROVIDER=google)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Groq (only needed if AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# App login (required) — shared password to access the dashboard
PASSWORD=
